{
  "AllowedHosts": "localhost;127.0.0.1;[::1];*.localhost",
  "BusinessTime": {
    "DefaultTimeZone": "Africa/Lagos"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ReverseProxy": {
    "KnownProxies": []
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Properties": {
      "Application": "TailorSpadi.Api"
    }
  },
  "Tenancy": {
    "BaseDomain": "localhost",
    "PlatformHosts": [
      "localhost",
      "127.0.0.1",
      "[::1]"
    ],
    "PublicScheme": "http",
    "PublicPort": 8080
  },
  "Auth": {
    "Issuer": "tailorspadi",
    "TenantAudience": "tailorspadi-tenant",
    "PlatformAudience": "tailorspadi-platform",
    "AdminAudience": "tailorspadi-admin",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14,
    "ClockSkewSeconds": 30,
    "MaxFailedLogins": 5,
    "LockoutMinutes": 15,
    "ResetTokenMinutes": 30,
    "CookieSecure": true,
    "AllowedOrigins": [],
    "AdminSeed": {
      "Enabled": false
    }
  },
  "Storage": {
    "Root": "storage",
    "MaxLogoBytes": 2097152,
    "MaxLogoPixels": 16000000,
    "LogoMaxEdge": 512
  },
  "RateLimiting": {
    "LoginPerMinute": 10,
    "RegisterPerMinute": 5,
    "PasswordResetPerMinute": 5,
    "RefreshPerMinute": 60,
    "SubdomainPerMinute": 60,
    "UploadPerMinute": 10
  }
}
