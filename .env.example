# Copy to .env and replace the placeholder. Never commit .env.
POSTGRES_DB=tailorspadi
POSTGRES_USER=tailorspadi
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=54329
GATEWAY_PORT=8080
GATEWAY_HTTPS_PORT=8443
# Signs access tokens. At least 32 random characters; never reuse across environments.
AUTH_SIGNING_KEY=replace-with-a-random-signing-key
# Set to true when the gateway is served over TLS so refresh cookies carry the Secure flag.
AUTH_COOKIE_SECURE=true
TENANCY_BASE_DOMAIN=tailorspadi.localhost
TENANCY_PUBLIC_SCHEME=https
